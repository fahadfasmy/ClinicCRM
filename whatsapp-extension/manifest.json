{
  "manifest_version": 3,
  "name": "Clinic CRM – WhatsApp capture",
  "short_name": "CRM WhatsApp",
  "version": "1.3.0",
  "description": "Adds new WhatsApp Web enquiries to Clinic CRM as leads and shows each contact's CRM status.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://crm.example.ae/*",
    "http://localhost:8080/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Clinic CRM – WhatsApp capture" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
