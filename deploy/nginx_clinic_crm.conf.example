# deploy/nginx_clinic_crm.conf.example — Nginx site for the UAE servers (Nginx ignores .htaccess, so the same
# protections are repeated here). Copy to /etc/nginx/sites-available/, replace the CHANGE_ME values, test with nginx -t.

server {
    listen 80;
    server_name CHANGE_ME_crm.example.ae;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME_crm.example.ae;
    root /var/www/clinic-crm/current;          # the code; config, logs, backups and storage live OUTSIDE this folder
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/CHANGE_ME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 12m;                  # uploads are capped at 10 MB in the app
    autoindex off;

    # Same rules as .htaccess: dumps, notes, logs, hidden files and code/tool/test/storage folders are never served
    location ~* \.(sql|sql\.gz|md|txt|log|bak|old|orig|swp|ini|env|sh|dist|example|lock)$ { return 404; }
    location ~ /\.(?!well-known) { return 404; }
    location ~ ^/(includes|local|tests|tools|migrations|storage|backups|lang|deploy|docs)(/|$) { return 404; }

    location / { try_files $uri $uri/ =404; }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param CRM_CONFIG /etc/clinic-crm/crm_config.php;   # secrets file, readable by the PHP user only
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
}
